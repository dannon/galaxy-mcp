# Galaxy MCP Configuration

# Galaxy instance connection
GALAXY_URL="http://localhost:8080"
GALAXY_API_KEY="your_galaxy_api_key_here"

# TACC SambaNova Inference API (Endpoint 1 - Multi-model)
# Get credentials from TACC or see IMPLEMENTATION_HANDOFF.md in tacc-inference repo
SAMBANOVA_BASE_URL="https://tejas.tacc.utexas.edu/v1/YOUR_ENDPOINT_ID_HERE"
SAMBANOVA_API_KEY="your_sambanova_api_key_here"
SAMBANOVA_MODEL="DeepSeek-V3"

# Available models on Endpoint 1:
# - Meta-Llama-3.1-405B-Instruct (405B params - complex reasoning, high accuracy)
# - Meta-Llama-3.1-8B-Instruct (8B params - fast responses, simpler tasks)
# - DeepSeek-R1 (advanced reasoning)
# - DeepSeek-V3 (general purpose - recommended for testing)
# - e5-mistral-7B-instruct (7B params - efficient instruction following)

# MCP Server Connection (for CLI agent)
MCP_SERVER_URL="http://localhost:3000/sse"
